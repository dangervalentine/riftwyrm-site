# Copy to /opt/riftwyrm-site/deploy/.env on the server (mode 600) and fill in from the old
# host's .env.local. Never commit the filled file. BETA_SIGNUPS_FILE and
# ASC_PRIVATE_KEY_PATH are set by the image and docker-compose.yml; leave them out.

# Email for each sign-up and the Android invitations (lib/notify.ts).
GMAIL_USER=
GMAIL_APP_PASSWORD=
BETA_NOTIFY_TO=

# TestFlight invitations (lib/testflight.ts). The .p8 key itself goes in
# /opt/riftwyrm-site/secrets/asc.p8 (mode 600), mounted read-only.
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_BETA_GROUP_ID=
